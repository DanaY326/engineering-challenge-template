# Copy to .env (git-ignored) and fill in. Loaded automatically on startup;
# variables already set in your shell take precedence.

# Kalshi API key ID (Account & security → API Keys)
KALSHI_API_KEY_ID=

# Path to the private key Kalshi gave you (RSA or Ed25519 PEM)
KALSHI_PRIVATE_KEY_PATH=

# Optional: log level (e.g. info, debug, engineering_challenge::collector::shard=debug)
# RUST_LOG=info
